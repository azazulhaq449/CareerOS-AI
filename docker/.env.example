# Copy this file to .env (gitignored) and set real local values.
POSTGRES_DB=careeros
POSTGRES_USER=careeros
POSTGRES_PASSWORD=changeme

# App secrets for the containerized API.
# JWT_KEY should be a long random string — e.g. generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_KEY=changeme
JWT_ISSUER=CareerOS.Server
JWT_AUDIENCE=CareerOS.Admin
ADMIN_EMAIL=changeme@example.com
ADMIN_PASSWORD=changeme
