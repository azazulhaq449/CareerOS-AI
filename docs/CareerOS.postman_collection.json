{
  "info": {
    "name": "CareerOS API",
    "description": "Auth + full CRUD for the CareerOS portfolio API. Run 'Auth > Login' first — it auto-captures the JWT into the accessToken collection variable, which every other request uses via inherited Bearer auth.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5257" },
    { "key": "accessToken", "value": "" },
    { "key": "experienceId", "value": "" },
    { "key": "projectId", "value": "" },
    { "key": "skillGroupId", "value": "" },
    { "key": "strengthId", "value": "" },
    { "key": "certificationId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "auth": { "type": "noauth" },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"your-admin-email\",\n  \"password\": \"your-admin-password\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.test('login succeeded', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": { "raw": "{{baseUrl}}/api/profile", "host": ["{{baseUrl}}"], "path": ["api", "profile"] }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Azaz ul Haq\",\n  \"initials\": \"AH\",\n  \"title\": \"Senior Software Engineer\",\n  \"roles\": [\"Senior .NET Engineer\"],\n  \"location\": \"Manchester, United Kingdom\",\n  \"email\": \"azaz.ulhaqq@gmail.com\",\n  \"phone\": \"+44 7774 031733\",\n  \"phoneHref\": \"tel:+447774031733\",\n  \"linkedInUrl\": \"https://www.linkedin.com/in/azaz-ul-haq-dev/\",\n  \"summary\": [\"Paragraph one.\"]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/profile", "host": ["{{baseUrl}}"], "path": ["api", "profile"] }
          }
        },
        {
          "name": "Get Strengths",
          "request": {
            "method": "GET",
            "auth": { "type": "noauth" },
            "url": { "raw": "{{baseUrl}}/api/profile/strengths", "host": ["{{baseUrl}}"], "path": ["api", "profile", "strengths"] }
          }
        },
        {
          "name": "Create Strength",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"icon\": \"uil-server\",\n  \"title\": \"Example Strength\",\n  \"description\": \"Description here.\",\n  \"sortOrder\": 0\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/profile/strengths", "host": ["{{baseUrl}}"], "path": ["api", "profile", "strengths"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["const body = pm.response.json();", "pm.collectionVariables.set('strengthId', body.id);"] }
            }
          ]
        },
        {
          "name": "Update Strength",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"icon\": \"uil-server\",\n  \"title\": \"Updated Strength\",\n  \"description\": \"Updated description.\",\n  \"sortOrder\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/profile/strengths/{{strengthId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "profile", "strengths", "{{strengthId}}"]
            }
          }
        },
        {
          "name": "Delete Strength",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/profile/strengths/{{strengthId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "profile", "strengths", "{{strengthId}}"]
            }
          }
        }
      ]
    },
